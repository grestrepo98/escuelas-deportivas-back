{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && node build.mjs",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-escuelas-rules \"vitest run --config vitest.rules.config.ts\"",
    "test:integration": "npm run build && firebase emulators:exec --only auth,firestore,functions --project demo-escuelas-integration \"vitest run --config vitest.integration.config.ts\"",
    "seed:emulator": "tsx src/scripts/seed.ts --target emulator",
    "seed:dev": "tsx src/scripts/seed.ts --target dev",
    "tenant:create": "tsx src/scripts/create-tenant.ts",
    "smoke:dev": "tsx src/scripts/smoke-dev.ts --target dev",
    "smoke:emulator": "npm run build && firebase emulators:exec --only auth,firestore,functions --project demo-escuelas-smoke \"npm run seed:emulator && tsx src/scripts/smoke-dev.ts --target emulator\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/eslint": "^8.56.12",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase": "^12.19.0",
    "firebase-functions-test": "^3.4.1",
    "firebase-tools": "^15.32.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vitest": "^3.2.0"
  },
  "private": true
}
